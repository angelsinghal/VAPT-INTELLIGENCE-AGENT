# ── Groq (Free Cloud LLM) ──────────────────────────────────────────
# Required: your free Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Model to use (llama-3.1-8b-instant is extremely fast and free)
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings (Runs locally for free) ─────────────────────────────
# Sentence Transformers model used for RAG knowledge base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ───────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Server ─────────────────────────────────────────────────────────
PORT=8000
MAX_CONCURRENT_ANALYSES=4
DISABLE_RATE_LIMIT=0
LOG_LEVEL=INFO
